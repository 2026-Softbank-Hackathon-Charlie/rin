# Copy to .env for local runs. .env is git-ignored. Never commit real values.

# Slack app "Rin" (Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
RIN_CHANNEL_ID=C0CCZ9RJ52T
# Team members allowed to call Rin (Slack user IDs, comma separated)
RIN_ALLOWED_USERS=U0C4A1HL3EH,U0C4D0R3XJS,U0C4J144FEH,U0C4K3UE58U,U0C4QG4TRAS

# Anthropic (key from the "rin" workspace, monthly limit $200)
ANTHROPIC_API_KEY=
RIN_MODEL=claude-opus-5-5

# GitHub App "charlie-rin". Give the private key either as a path or as base64 of the .pem file.
GITHUB_APP_ID=5581776
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_APP_PRIVATE_KEY_PATH=

# View-only AWS keys of IAM user rin-ai (from SSM /rin/RIN_AI_*), handed to Claude only
RIN_AI_AWS_ACCESS_KEY_ID=
RIN_AI_AWS_SECRET_ACCESS_KEY=

# Read-only Cloudflare token (SSM /rin/CLOUDFLARE_API_TOKEN). Used by Rin's tools, never handed to Claude.
CLOUDFLARE_API_TOKEN=

# Local only
DATABASE_URL=postgres://rin:rin@localhost:5433/rin
RIN_WORKSPACE=./.data/workspace
RIN_CLAUDE_CONFIG_DIR=./.data/claude
